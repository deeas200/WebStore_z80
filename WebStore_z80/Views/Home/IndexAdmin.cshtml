@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
}

<div class="col-lg-8">
    <div class="card shadow">
        <div class="card-header bg-white">
            <h5 class="mb-0">آمار ماهانه</h5>
        </div>
        <div class="card-body">
            <canvas id="chart" height="250"></canvas>
        </div>
    </div>
</div>

<div class="col-lg-4">
    <div class="card shadow">
        <div class="card-header bg-white">
            <h5 class="mb-0">فعالیت‌های اخیر</h5>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span>کاربر جدید ثبت‌نام کرد</span>
                    <small class="text-muted">2 ساعت پیش</small>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>سفارش جدید ثبت شد</span>
                    <small class="text-muted">4 ساعت پیش</small>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>پروژه به روزرسانی شد</span>
                    <small class="text-muted">1 روز پیش</small>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>مشکل سیستم حل شد</span>
                    <small class="text-muted">2 روز پیش</small>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>گزارش ماهانه ارسال شد</span>
                    <small class="text-muted">3 روز پیش</small>
                </li>
            </ul>
        </div>
    </div>
</div>